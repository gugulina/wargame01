# 临时截图、调试脚本、自战输出（下划线开头一律忽略）
_*.png
_*.js
_*.html
_*.txt
__pycache__/
*.log

# 系统
Thumbs.db
.DS_Store
desktop.ini

# 依赖
node_modules/

# Android 构建产物
android/
www/
*.apk

# 项目管理数据（私人笔记，不公开）
.workbuddy/

# 音效挑选时的临时工作区（原始下载 + 分析产物）
game/_cand/

# 试听页的内嵌版：1 MB base64，由骨架 sfx-demo.html 生成
# （npm run sfx:embed）。入库的代价是每改一次音效就整体重写一遍，
# diff 里看不出任何东西。
game/audio-lab/*.embed.html

# 音效备选毛料（v4.21 出库）：15 个 mp3 共 332 KB，没有任何页面引用，
# 只是当初挑素材时的 A/B 备选。判据见 docs/17 P2-2——毛料不进库，
# 要听的话本地留着就行（仓库里只剩 README 说明）。
game/audio-lab/cand/*.mp3
